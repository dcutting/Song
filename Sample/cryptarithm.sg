#cipher.permutation(r, c, d) = r + cipher.map(|m| m.insert(c, d))

#"".permute(_) = []
#_.permute([]) = []
#[c|cs].permute(digits) = digits.reduce([], |r, d|
#	cs.permute(digits.select(|d2| d Neq d2)).permutation(r, c, d)
#)

permute("", digits) = []
permute([c|cs], digits) = digits.reduce(emptyDict, |r, d| Do
  tp = permute(cs, digits.reject(|x| x Eq d))
  _permute(tp, r, c, d)
End)

_permute([], r, c, d) = r + emptyDict.insert(c, d)
_permute(tp, r, c, d) = r + tp.map(|x| x.insert(c, d))

[] Eq "".permute([1, 2])
[] Eq "AB".permute([])
#[['A', 1]] Eq 
"A".permute([1])
#[['A', 1], ['B', 1]] Eq 
"AB".permute([1])
#[['A', 1], ['A', 2]] Eq 
"A".permute([1, 2])
#[['A', 1], ['A', 2], ['B', 1], ['B', 2]] Eq 
"AB".permute([1, 2])

#cryptarithm.allCiphers = cryptarithm.allLetters.permute(allDigits)
cryptarithm.solve = cryptarithm.allCiphers.select(|cipher| [cipher, cryptarithm].isValid)

terms = ["DAD", "ODD"]
cryptarithm = [terms, "TOO"]
#cryptarithm.allCiphers
cryptarithm.solve
