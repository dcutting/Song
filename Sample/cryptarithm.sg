cipher = emptyDict.insert('D', 6).insert('A', 5).insert('T', 9).insert('O', 2).insert('Y', 0)

allDigits = 0.upToAndIncluding(9)

[cipher, word].startsWithZero? = cipher.lookup(word.first) Eq 0
Yes Eq [cipher, "YAY"].startsWithZero?
No Eq [cipher, "ADD"].startsWithZero?

[cipher, word].value = word.reverse.enumerate.inject(0, |a, [x, i]| a + cipher.lookup(x) * 10^i)
566 Eq [cipher, "ADD"].value

[cipher, words].values = words.map(|word| [cipher, word].value)
[566, 922] Eq [cipher, ["ADD", "TOO"]].values

cipherWords.sumUp = cipherWords.values.sum
1488 Eq [cipher, ["ADD", "TOO"]].sumUp

cryptarithm.allLetters = cryptarithm.flatten.unique.sortBy(scalar)
"ADT" Eq [["DAD", "AD"], "TAD"].allLetters

[cipher, [terms, result]].isValid =
	Not terms.any?(|t| [cipher, t].startsWithZero?) And [cipher, result].value Eq [cipher, terms].sumUp
Yes Eq [cipher, [["DAD", "ODD"], "TOO"]].isValid
No Eq [cipher, [["DAD", "TOO"], "ODD"]].isValid

